PORT=5000
FRONTEND_URL=http://localhost:5173
# Extra origins allowed to call this API besides FRONTEND_URL — comma-separated
# (e.g. a custom domain alongside the Render URL, or a staging frontend).
# ADDITIONAL_CORS_ORIGINS=https://hackathon.example.com,https://staging.example.com

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
RESEND_API_KEY=
EMAIL_FROM=
JWT_SECRET=

# Razorpay Standard Checkout — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured against the /api/teams/payment/webhook endpoint
# in the Razorpay dashboard (Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Google Drive OAuth client (team PPT submissions) — a dedicated Google
# account owns the destination folder; the backend authenticates as it via
# this long-lived refresh token (see google-drive.ts). See the Google Cloud
# Console (APIs & Services > Credentials) to create the OAuth client, and
# the OAuth Playground (with "use your own credentials") to mint the
# refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=